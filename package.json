{
  "name": "volle-lotte",
  "version": "0.0.0",
  "description": "Online multiplayer web app for the dice game Volle Lotte. Angular + NestJS + SQLite.",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "nx run-many -t serve -p backend frontend",
    "build": "nx run-many -t build -p backend frontend",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t e2e",
    "test:affected": "nx affected -t test --base=main",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "typecheck": "nx run-many -t typecheck",
    "release": "nx release",
    "test:coverage": "nx run-many -t test --coverage --outputStyle=static",
    "sonar:local": "bash scripts/sonar-local.sh",
    "sonar:local:up": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:local:down": "docker compose -f docker-compose.sonar.yml down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs,json,html,scss,css,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@angular-devkit/core": "~22.2.2",
    "@angular-devkit/schematics": "~22.2.2",
    "@angular/build": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/language-service": "~22.2.3",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@schematics/angular": "~22.1.8",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.4.1",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "secretlint": "^13.0.5",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.3",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@primeuix/themes": "^3.0.1",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io-client": "^4.8.4"
  }
}

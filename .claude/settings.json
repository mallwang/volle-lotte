{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:affected)",
      "Bash(npm run format:check)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | xargs -r \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
